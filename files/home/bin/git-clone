#!/usr/bin/env python3
"""Clone git repos to ~/src/<host>/<path> and open a shell in the checkout.

Usage: git-clone <url> [git clone options...]

If the checkout already exists it is fetched and its status against the
upstream branch is reported instead of cloning.
"""

import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


def parse_url(url: str) -> tuple[str, list[str]]:
    """Return the host and path segments of a clone URL."""
    if "://" in url:
        parts = urlsplit(url)
        host, path = parts.hostname, parts.path
    else:
        # scp-style "user@host:path"
        m = re.match(r"^(?:[^@/]+@)?([^:/]+):(.*)$", url)
        if m is None:
            sys.exit(f"git-clone: cannot parse repository URL: {url}")
        host, path = m.groups()
    segments = [seg for seg in path.split("/") if seg]
    if not host or not segments:
        sys.exit(f"git-clone: cannot parse repository URL: {url}")
    segments[-1] = segments[-1].removesuffix(".git")
    return host.lower(), segments


def git(repo_dir: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=repo_dir, capture_output=True, text=True)


def report_status(repo_dir: Path) -> None:
    """Fetch and print whether the checkout is up to date with its upstream."""
    print("Fetching...", file=sys.stderr)
    fetch = subprocess.run(["git", "fetch", "--quiet"], cwd=repo_dir)
    if fetch.returncode != 0:
        print("Fetch failed: status below may be stale", file=sys.stderr)

    branch = git(repo_dir, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip()
    upstream = git(repo_dir, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if not branch:
        print("HEAD is detached", file=sys.stderr)
    elif upstream.returncode != 0:
        print(f"Branch {branch} has no upstream", file=sys.stderr)
    else:
        upstream = upstream.stdout.strip()
        counts = git(repo_dir, "rev-list", "--left-right", "--count", "HEAD...@{u}").stdout.split()
        ahead, behind = (int(c) for c in counts)
        if ahead == 0 and behind == 0:
            print(f"Up to date with {upstream}", file=sys.stderr)
        elif ahead and behind:
            print(f"Diverged from {upstream}: {ahead} ahead, {behind} behind", file=sys.stderr)
        elif behind:
            print(f"Behind {upstream} by {behind} commit(s)", file=sys.stderr)
        else:
            print(f"Ahead of {upstream} by {ahead} commit(s)", file=sys.stderr)

    if git(repo_dir, "status", "--porcelain").stdout.strip():
        print("Working tree has uncommitted changes", file=sys.stderr)


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__.strip())

    url, clone_args = sys.argv[1], sys.argv[2:]
    host, segments = parse_url(url)
    repo_dir = Path.home() / "src" / host
    for seg in segments:
        repo_dir /= seg

    if repo_dir.exists():
        if not (repo_dir / ".git").exists():
            sys.exit(f"git-clone: {repo_dir} exists but is not a git repository")
        print(f"{repo_dir} already exists", file=sys.stderr)
        report_status(repo_dir)
    else:
        repo_dir.parent.mkdir(parents=True, exist_ok=True)
        try:
            clone = subprocess.run(["git", "clone", *clone_args, "--", url, repo_dir.as_posix()])
        except KeyboardInterrupt:
            sys.exit(130)
        if clone.returncode != 0:
            sys.exit(clone.returncode)

    print(repo_dir, file=sys.stderr)
    os.chdir(repo_dir)
    shell = os.environ.get("SHELL", "/bin/bash")
    os.execvp(shell, [shell])


if __name__ == "__main__":
    main()
