[org/mate/panel/general]
toplevel-id-list=['bottom']
object-id-list=['menu', 'show-desktop', 'firefox', 'terminal', 'window-list', 'notification-area', 'clock']

[org/mate/panel/toplevels/bottom]
expand=true
orientation='bottom'
size=28
screen=0

[org/mate/panel/objects/menu]
object-type='menu'
toplevel-id='bottom'
position=0
locked=true
use-menu-path=false

[org/mate/panel/objects/show-desktop]
object-type='applet'
applet-iid='WnckletFactory::ShowDesktopApplet'
toplevel-id='bottom'
position=10
locked=true

[org/mate/panel/objects/firefox]
object-type='launcher'
launcher-location='/usr/share/applications/firefox.desktop'
toplevel-id='bottom'
position=20
locked=true

[org/mate/panel/objects/terminal]
object-type='launcher'
launcher-location='/usr/share/applications/mate-terminal.desktop'
toplevel-id='bottom'
position=30
locked=true

[org/mate/panel/objects/window-list]
object-type='applet'
applet-iid='WnckletFactory::WindowListApplet'
toplevel-id='bottom'
position=40
locked=true

[org/mate/panel/objects/notification-area]
object-type='applet'
applet-iid='NotificationAreaAppletFactory::NotificationArea'
toplevel-id='bottom'
position=10
relative-to-edge='end'
locked=true

[org/mate/panel/objects/clock]
object-type='applet'
applet-iid='ClockAppletFactory::ClockApplet'
toplevel-id='bottom'
position=0
relative-to-edge='end'
locked=true

[org/mate/panel/objects/clock/prefs]
format='12-hour'
show-date=false
